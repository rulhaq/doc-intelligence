## =========================
## QPP PoC - Environment
## =========================

## --- Backend (FastAPI) ---
# PostgreSQL connection used by `backend/models/database.py`
DATABASE_URL=postgresql://user:password@postgres:5432/qpp

# JWT signing secret used by `backend/services/auth_service.py`
# Use a long random string (32+ chars recommended).
SECRET_KEY=change-me-to-a-long-random-string

# Qdrant connection used by `backend/services/vector_store.py`
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# vLLM OpenAI-compatible base URL used by `backend/services/llm_service.py`
VLLM_BASE_URL=http://vllm:8000

## --- Frontend (Vite) ---
# Optional: override API base URL for local dev builds.
# Default is "/api" (works with Vite proxy and with the frontend nginx reverse-proxy).
VITE_API_BASE_URL=/api


