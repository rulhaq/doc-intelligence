    "react": "^17.0.0",
    "react-dom": "^17.0.0",
    "react-i18next": "^13.5.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "prettier": "^3.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
