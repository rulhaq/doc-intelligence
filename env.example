# Application
APP_NAME="CustomerLLM"
APP_ENV=production
DEBUG=false
API_VERSION=v1

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=https://customerllm-backend.example.com
FRONTEND_URL=https://customerllm-frontend.example.com

# Frontend
VITE_API_URL=https://customerllm-backend.example.com
VITE_WS_URL=wss://customerllm-backend.example.com
VITE_GRAFANA_URL=
VITE_QDRANT_URL=
VITE_PROMETHEUS_URL=

# Database (PostgreSQL)
POSTGRES_DB=customerllm
POSTGRES_USER=customerllm
POSTGRES_PASSWORD=changeme_secure_password
DATABASE_URL=postgresql://customerllm:changeme_secure_password@postgres:5432/customerllm

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# PVC File Storage
STORAGE_MODE=pvc
FILE_STORAGE_PATH=/data

# vLLM (OpenAI-compatible)
VLLM_BASE_URL=https://vllm.example.com
VLLM_MODEL=your-chat-model
VLLM_EMBEDDING_BASE_URL=https://vllm-embeddings.example.com
VLLM_EMBEDDING_MODEL=your-embedding-model
VLLM_API_TOKEN=changeme_token
VLLM_TIMEOUT=300

# Embeddings provider selection
EMBEDDINGS_PROVIDER=tei

# TEI (Text Embeddings Inference)
TEI_BASE_URL=http://tei:8080
TEI_API_TOKEN=
TEI_TIMEOUT=60

# OCR
OCR_WORKER_URL=http://ocr-worker:8001
OCR_WORKER_PORT=8001
PADDLEOCR_LANG=en,ar

# Security
SECRET_KEY=changeme_generate_secure_random_key_here_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=https://customerllm-frontend.example.com
