APP_NAME=CustomerLLM
APP_ENV=production
DEBUG=false
API_VERSION=v1

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# update this when deploying
BACKEND_URL=https://customerllm-backend-scalovate-qpp-redhat-poc.apps.cluster-4zxqb.4zxqb.sandbox134.opentlc.com
# update this when deploying
FRONTEND_URL=https://customerllm-frontend-scalovate-qpp-redhat-poc.apps.cluster-4zxqb.4zxqb.sandbox134.opentlc.com

# Frontend
# update this when deploying
VITE_API_URL=https://customerllm-backend-scalovate-qpp-redhat-poc.apps.cluster-4zxqb.4zxqb.sandbox134.opentlc.com
# update this when deploying
VITE_WS_URL=wss://customerllm-backend-scalovate-qpp-redhat-poc.apps.cluster-4zxqb.4zxqb.sandbox134.opentlc.com
VITE_GRAFANA_URL=
VITE_QDRANT_URL=
VITE_PROMETHEUS_URL=

# Database (PostgreSQL)
POSTGRES_DB=customerllm
POSTGRES_USER=customerllm
# update this when deploying
POSTGRES_PASSWORD=changeme_secure_password
# update this when deploying
DATABASE_URL=postgresql://customerllm:changeme_secure_password@postgres:5432/customerllm
# Note: if you ever change `POSTGRES_PASSWORD` after Postgres has already initialized its PVC,
# you must delete/recreate the Postgres PVC to re-initialize (otherwise you'll get auth failures).

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# Storage (PVC)
STORAGE_MODE=pvc
FILE_STORAGE_PATH=/data

# vLLM (token-protected routes)
VLLM_BASE_URL=https://llama-31-8b-instruct-miro-test.apps.cluster-4zxqb.4zxqb.sandbox134.opentlc.com
VLLM_API_TOKEN=
# Keep the health check enabled so startup logs show whether the LLM endpoint is reachable,
# but do not block the backend from starting until you have a valid token/model.
VLLM_HEALTHCHECK_ENABLED=true
VLLM_HEALTHCHECK_STRICT=false
# update this when deploying
VLLM_MODEL=dummy-model

# update this when deploying (maybe not using this anymore)
VLLM_EMBEDDING_BASE_URL=
# update this when deploying (maybe not using this anymore)
VLLM_EMBEDDING_MODEL=
VLLM_TIMEOUT=300
VLLM_TEMPERATURE=0.2

# Embeddings provider (TEI)
EMBEDDINGS_PROVIDER=tei
TEI_BASE_URL=http://tei:8080
TEI_API_TOKEN=
TEI_TIMEOUT=120

# OCR
OCR_WORKER_URL=http://ocr-worker:8001
OCR_WORKER_PORT=8001
PADDLEOCR_LANG=en,ar
OCR_LLM_CORRECTION_ENABLED=true

# Security
# update this when deploying
SECRET_KEY=changeme_generate_secure_random_key_here_min_32_chars

# CORS
# update this when deploying
CORS_ORIGINS=https://customerllm-frontend-scalovate-qpp-redhat-poc.apps.cluster-4zxqb.4zxqb.sandbox134.opentlc.com

# Seed users (one-time job)
SEED_USERS=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123456
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_FULL_NAME=Admin User
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=user123456
SEED_USER_USERNAME=user
SEED_USER_FULL_NAME=Demo User
